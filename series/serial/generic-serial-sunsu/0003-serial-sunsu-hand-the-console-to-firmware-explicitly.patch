+static void sunsu_write_fcr(struct uart_sunsu_port *up, unsigned int value)
+{
+	up->fcr = value & ~(UART_FCR_CLEAR_RCVR | UART_FCR_CLEAR_XMIT);
+	serial_out(up, UART_FCR, value);
+}
