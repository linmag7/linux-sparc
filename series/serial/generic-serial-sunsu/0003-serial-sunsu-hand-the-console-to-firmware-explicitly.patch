+}
+
+static inline int sunsu_prom_begin(struct sunsu_prom_handoff *state)
+{
+	return -EOPNOTSUPP;
+}
+
+static inline int sunsu_prom_end(struct sunsu_prom_handoff *state)
+{
+	return -EOPNOTSUPP;
+}
+#endif
