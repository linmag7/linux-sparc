 extern enum ultra_tlb_layout tlb_type;
 
+/* Shared JPS MMU/cache operations, not a platform or SMP capability. */
+static inline bool sparc64_fujitsu_mmu(void)
+{
+	return tlb_type == sparc64_vii || tlb_type == sparc64_v;
