From 76768eb42d7766262efa4a8e5e3a91b72d2cc38c Mon Sep 17 00:00:00 2001
From: Magnus Lindholm <linmag7@gmail.com>
Date: Sat, 7 Nov 2026 00:19:07 +0100
Subject: [RFC PATCH 9/9] sparc64: check client-interface status in PROM
 wrappers

Check wrapper status before consuming firmware result cells. Preserve
tree-service error sentinels and report a refused monitor request instead
of treating it as completed. Stop locally if stop-self was refused.

A failed return validation may follow execution of the service, so do
not retry it or treat a populated result cell as proof of success.

Signed-off-by: Magnus Lindholm <linmag7@gmail.com>
---
 arch/sparc/include/asm/oplib_64.h |  2 +-
 arch/sparc/prom/console_64.c      |  3 ++-
 arch/sparc/prom/misc_64.c         | 12 +++++++++---
 arch/sparc/prom/tree_64.c         | 27 ++++++++++++++++++---------
 4 files changed, 30 insertions(+), 14 deletions(-)

diff --git a/arch/sparc/include/asm/oplib_64.h b/arch/sparc/include/asm/oplib_64.h
index 0cad3897bbd7..94a78bfb30bc 100644
--- a/arch/sparc/include/asm/oplib_64.h
+++ b/arch/sparc/include/asm/oplib_64.h
@@ -80,7 +80,7 @@ void prom_feval(const char *forth_string);
 /* Enter the prom, with possibility of continuation with the 'go'
  * command in newer proms.
  */
-void prom_cmdline(void);
+int prom_cmdline(void);
 
 /* Enter the prom, with no chance of continuation for the stand-alone
  * which calls this.
diff --git a/arch/sparc/prom/console_64.c b/arch/sparc/prom/console_64.c
index 4fe7a8db94bf..50df0d5be075 100644
--- a/arch/sparc/prom/console_64.c
+++ b/arch/sparc/prom/console_64.c
@@ -26,7 +26,8 @@ static int __prom_console_write_buf(const char *buf, int len)
 	args[5] = (unsigned int) len;
 	args[6] = (unsigned long) -1;
 
-	p1275_cmd_direct(args);
+	if (p1275_cmd_direct(args))
+		return -EBUSY;
 
 	ret = (int) args[6];
 	if (ret < 0)
diff --git a/arch/sparc/prom/misc_64.c b/arch/sparc/prom/misc_64.c
index 8966ae89c47e..db43debcf825 100644
--- a/arch/sparc/prom/misc_64.c
+++ b/arch/sparc/prom/misc_64.c
@@ -96,10 +96,11 @@ EXPORT_SYMBOL(prom_feval);
 /* Drop into the prom, with the chance to continue with the 'go'
  * prom command.
  */
-void prom_cmdline(void)
+int prom_cmdline(void)
 {
 	unsigned long args[3];
 	unsigned long flags;
+	int ret;
 
 	local_irq_save(flags);
 
@@ -111,13 +112,14 @@ void prom_cmdline(void)
 	args[1] = 0;
 	args[2] = 0;
 
-	p1275_cmd_direct(args);
+	ret = p1275_cmd_direct(args);
 
 #ifdef CONFIG_SMP
 	smp_release();
 #endif
 
 	local_irq_restore(flags);
+	return ret;
 }
 
 /* Drop into the prom, but completely terminate the program.
@@ -432,7 +434,11 @@ void prom_stopself(void)
 	args[0] = (unsigned long) "SUNW,stop-self";
 	args[1] = 0;
 	args[2] = 0;
-	p1275_cmd_direct(args);
+	if (p1275_cmd_direct(args)) {
+		local_irq_disable();
+		for (;;)
+			cpu_relax();
+	}
 }
 
 void prom_idleself(void)
diff --git a/arch/sparc/prom/tree_64.c b/arch/sparc/prom/tree_64.c
index 7388339bbd7e..103b488dec41 100644
--- a/arch/sparc/prom/tree_64.c
+++ b/arch/sparc/prom/tree_64.c
@@ -27,7 +27,8 @@ static phandle prom_node_to_node(const char *type, phandle node)
 	args[3] = (unsigned int) node;
 	args[4] = (unsigned long) -1;
 
-	p1275_cmd_direct(args);
+	if (p1275_cmd_direct(args))
+		return (phandle)-1;
 
 	return (phandle) args[4];
 }
@@ -104,7 +105,8 @@ int prom_getproplen(phandle node, const char *prop)
 	args[4] = (unsigned long) prop;
 	args[5] = (unsigned long) -1;
 
-	p1275_cmd_direct(args);
+	if (p1275_cmd_direct(args))
+		return -1;
 
 	return (int) args[5];
 }
@@ -133,7 +135,8 @@ int prom_getproperty(phandle node, const char *prop,
 	args[6] = bufsize;
 	args[7] = (unsigned long) -1;
 
-	p1275_cmd_direct(args);
+	if (p1275_cmd_direct(args))
+		return -1;
 
 	return (int) args[7];
 }
@@ -252,7 +255,8 @@ char *prom_firstprop(phandle node, char *buffer)
 	args[5] = (unsigned long) buffer;
 	args[6] = (unsigned long) -1;
 
-	p1275_cmd_direct(args);
+	if (p1275_cmd_direct(args))
+		*buffer = 0;
 
 	return buffer;
 }
@@ -284,7 +288,8 @@ char *prom_nextprop(phandle node, const char *oprop, char *buffer)
 	args[5] = (unsigned long) buffer;
 	args[6] = (unsigned long) -1;
 
-	p1275_cmd_direct(args);
+	if (p1275_cmd_direct(args))
+		*buffer = 0;
 
 	return buffer;
 }
@@ -302,7 +307,8 @@ phandle prom_finddevice(const char *name)
 	args[3] = (unsigned long) name;
 	args[4] = (unsigned long) -1;
 
-	p1275_cmd_direct(args);
+	if (p1275_cmd_direct(args))
+		return (phandle)-1;
 
 	return (int) args[4];
 }
@@ -350,7 +356,8 @@ prom_setprop(phandle node, const char *pname, char *value, int size)
 	args[6] = size;
 	args[7] = (unsigned long) -1;
 
-	p1275_cmd_direct(args);
+	if (p1275_cmd_direct(args))
+		return -1;
 
 	return (int) args[7];
 }
@@ -367,7 +374,8 @@ inline phandle prom_inst2pkg(int inst)
 	args[3] = (unsigned int) inst;
 	args[4] = (unsigned long) -1;
 
-	p1275_cmd_direct(args);
+	if (p1275_cmd_direct(args))
+		return 0;
 
 	node = (int) args[4];
 	if ((s32)node == -1)
@@ -387,7 +395,8 @@ int prom_ihandle2path(int handle, char *buffer, int bufsize)
 	args[5] = bufsize;
 	args[6] = (unsigned long) -1;
 
-	p1275_cmd_direct(args);
+	if (p1275_cmd_direct(args))
+		return -1;
 
 	return (int) args[6];
 }
