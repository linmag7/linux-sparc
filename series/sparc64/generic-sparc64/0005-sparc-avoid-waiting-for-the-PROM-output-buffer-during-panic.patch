From 9e5788fa78fc145afafaae68e42d4a0de259f4c3 Mon Sep 17 00:00:00 2001
From: Magnus Lindholm <linmag7@gmail.com>
Date: Fri, 6 Nov 2026 19:22:52 +0100
Subject: [RFC PATCH 5/9] sparc: avoid waiting for the PROM output buffer
 during panic

Panic can stop a CPU holding console_write_lock before flushing a
retained PROM console. Waiting for that owner prevents the flush from
returning. Try the lock during panic and drop the chunk if it is busy,
without modifying the shared buffer or entering firmware.

Keep normal serialization unchanged. This only avoids the buffer-lock
wait; it does not bound the firmware call or its separate entry lock.

Signed-off-by: Magnus Lindholm <linmag7@gmail.com>
---
 arch/sparc/prom/printf.c | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/arch/sparc/prom/printf.c b/arch/sparc/prom/printf.c
index dcee3dfa6de9..6bb4575a274a 100644
--- a/arch/sparc/prom/printf.c
+++ b/arch/sparc/prom/printf.c
@@ -17,6 +17,7 @@
 #include <linux/kernel.h>
 #include <linux/compiler.h>
 #include <linux/spinlock.h>
+#include <linux/panic.h>
 
 #include <asm/openprom.h>
 #include <asm/oplib.h>
@@ -34,7 +35,12 @@ void notrace prom_write(const char *buf, unsigned int n)
 	char *dest;
 
 	dest = console_write_buf;
-	raw_spin_lock_irqsave(&console_write_lock, flags);
+	if (panic_in_progress()) {
+		if (!raw_spin_trylock_irqsave(&console_write_lock, flags))
+			return;
+	} else {
+		raw_spin_lock_irqsave(&console_write_lock, flags);
+	}
 
 	dest_len = 0;
 	while (n-- != 0) {
