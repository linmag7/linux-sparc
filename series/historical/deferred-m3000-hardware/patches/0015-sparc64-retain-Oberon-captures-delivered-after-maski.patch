From 6e75fedce50a17808e9737c629f8b630d0d7f4b8 Mon Sep 17 00:00:00 2001
From: Magnus Lindholm <linmag7@gmail.com>
Date: Fri, 16 Oct 2026 00:24:12 +0200
Subject: [RFC PATCH 15/17] sparc64: retain Oberon captures delivered after
 masking

A mondo can be in flight when the deadline masks its route. Accept that
first delivery as a late capture, keep the route masked and report its
late status with the deferred snapshot. Do not clear or acknowledge it.

A subsequent delivery preserves the first snapshot and verifies masking
again. Failure to mask still enters the terminal containment path.

Signed-off-by: Magnus Lindholm <linmag7@gmail.com>
---
 arch/sparc/include/asm/irq_64.h |  2 +-
 arch/sparc/kernel/irq_64.c      | 11 ++++++-----
 arch/sparc/kernel/pci_fire.c    |  8 +++++---
 3 files changed, 12 insertions(+), 9 deletions(-)

diff --git a/arch/sparc/include/asm/irq_64.h b/arch/sparc/include/asm/irq_64.h
index 2a3fa756f8f6..007b1fdc8f15 100644
--- a/arch/sparc/include/asm/irq_64.h
+++ b/arch/sparc/include/asm/irq_64.h
@@ -48,7 +48,7 @@ unsigned int build_irq(int inofixup, unsigned long iclr, unsigned long imap);
 unsigned int oberon_build_irq(int inofixup, unsigned long iclr, unsigned long imap);
 /* The callback and argument must remain valid for the life of the IRQ. */
 int oberon_prepare_capture(unsigned int irq, unsigned long imap,
-			   void (*capture)(void *arg), void *arg);
+			   void (*capture)(void *arg, bool late), void *arg);
 unsigned int sun4v_build_irq(u32 devhandle, unsigned int devino);
 unsigned int sun4v_build_virq(u32 devhandle, unsigned int devino);
 unsigned int sun4v_build_msi(u32 devhandle, unsigned int *irq_p,
diff --git a/arch/sparc/kernel/irq_64.c b/arch/sparc/kernel/irq_64.c
index d781afc0fe45..2144900c276c 100644
--- a/arch/sparc/kernel/irq_64.c
+++ b/arch/sparc/kernel/irq_64.c
@@ -208,7 +208,7 @@ struct irq_handler_data {
 	unsigned long	iclr;
 	unsigned long	imap;
 	bool		oberon;
-	void (*capture)(void *arg);
+	void (*capture)(void *arg, bool late);
 	void *capture_arg;
 	bool captured;
 	bool capture_live;
@@ -711,19 +711,20 @@ static bool oberon_capture_mask(struct irq_handler_data *data)
 static void oberon_capture_irq(struct irq_desc *desc)
 {
 	struct irq_handler_data *data;
+	bool late = false;
 
 	guard(raw_spinlock)(&desc->lock);
 	data = irq_desc_get_handler_data(desc);
 	if (data->capture_live) {
-		if (!data->capture_armed || data->captured)
-			oberon_capture_stop(desc, 3);
+		/* Masking a route does not recall an interrupt already in flight. */
+		late = !data->capture_armed;
 		if (!oberon_capture_mask(data))
 			oberon_capture_stop(desc, 2);
 		data->capture_armed = false;
 	}
 	if (!data->captured) {
 		data->captured = true;
-		data->capture(data->capture_arg);
+		data->capture(data->capture_arg, late);
 	}
 }
 
@@ -748,7 +749,7 @@ static struct irq_chip oberon_capture_chip = {
 };
 
 int oberon_prepare_capture(unsigned int irq, unsigned long imap,
-			   void (*capture)(void *arg), void *arg)
+			   void (*capture)(void *arg, bool late), void *arg)
 {
 	struct irq_desc *desc = irq_to_desc(irq);
 	struct irq_handler_data *data;
diff --git a/arch/sparc/kernel/pci_fire.c b/arch/sparc/kernel/pci_fire.c
index 852ea6fbfcff..c0dcf30146f0 100644
--- a/arch/sparc/kernel/pci_fire.c
+++ b/arch/sparc/kernel/pci_fire.c
@@ -755,6 +755,7 @@ struct oberon_irq_capture {
 	bool rearm_requested;
 	int rearm_result;
 	unsigned int generation;
+	bool late;
 	unsigned int received_cpu;
 	unsigned long received_hard_id;
 	bool target_requested;
@@ -1007,9 +1008,9 @@ static void oberon_capture_report(struct work_struct *work)
 		struct oberon_irq_capture, report);
 	int i;
 
-	pr_warn("Oberon capture %s: generation=%u cpu=%u hard_id=%lu candidate samples\n",
+	pr_warn("Oberon capture %s: generation=%u cpu=%u hard_id=%lu late=%u candidate samples\n",
 		cap->pbm->name, cap->generation, cap->received_cpu,
-		cap->received_hard_id);
+		cap->received_hard_id, cap->late);
 	for (i = 0; i < ARRAY_SIZE(oberon_capture_status_regs); i++)
 		pr_warn("Oberon capture %s: reg=%lx before=%016llx after=%016llx\n",
 			cap->pbm->name, oberon_capture_status_regs[i],
@@ -1024,12 +1025,13 @@ static void oberon_capture_report(struct work_struct *work)
 				cap->header[i], cap->header_after[i]);
 }
 
-static void oberon_capture_event(void *arg)
+static void oberon_capture_event(void *arg, bool late)
 {
 	struct oberon_irq_capture *cap = arg;
 	unsigned long base = cap->pbm->pbm_regs;
 	int i;
 
+	cap->late = late;
 	cap->received_cpu = raw_smp_processor_id();
 	cap->received_hard_id = real_hard_smp_processor_id();
 	/* At most 26 CSR reads; equal samples do not prove an atomic snapshot. */
