From e661d7d20a23a472a814c272c0649bf944336bb8 Mon Sep 17 00:00:00 2001
From: Magnus Lindholm <linmag7@gmail.com>
Date: Sat, 7 Nov 2026 19:07:36 +0100
Subject: [PATCH 4/4] tg3: unregister the netdevice before releasing its
 resources

Removal releases PTP, firmware and PHY resources while the netdevice is
still registered. A concurrent open can therefore run against resources
being torn down, and an active device has not yet stopped its producers.
Closing the reset scheduling gate does not exclude other netdev operations.

Unregister first so the close path quiesces the device and netdev users
are detached before releasing these resources. Keep the reset drain ahead
of unregistration and the register mappings alive through all cleanup.

Signed-off-by: Magnus Lindholm <linmag7@gmail.com>
---
 drivers/net/ethernet/broadcom/tg3.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/drivers/net/ethernet/broadcom/tg3.c b/drivers/net/ethernet/broadcom/tg3.c
index d0a2bcbdebac..f5b19941ba40 100644
--- a/drivers/net/ethernet/broadcom/tg3.c
+++ b/drivers/net/ethernet/broadcom/tg3.c
@@ -18119,6 +18119,8 @@ static void tg3_remove_one(struct pci_dev *pdev)
 		tg3_reset_task_stop(tp);
 		rtnl_unlock();
 
+		unregister_netdev(dev);
+
 		tg3_ptp_fini(tp);
 
 		release_firmware(tp->fw);
@@ -18128,7 +18130,6 @@ static void tg3_remove_one(struct pci_dev *pdev)
 			tg3_mdio_fini(tp);
 		}
 
-		unregister_netdev(dev);
 		if (tp->aperegs) {
 			iounmap(tp->aperegs);
 			tp->aperegs = NULL;
-- 
